---
import '../styles/global.css';
import { SITE } from '../config';
import { getImage } from 'astro:assets';
import ogSource from '../assets/screens/key-1.jpg';
import { Image } from 'astro:assets';
import gameTitle from '../assets/game/title.png';
import { languages, langs, type Lang } from '../i18n/ui';
import { t, localePath, stripLang } from '../i18n/utils';

interface Props { lang: Lang; title?: string; description?: string }
const { lang, title, description } = Astro.props;
const d = t(lang);
const page = stripLang(Astro.url.pathname);
const fullTitle = title ? `${title} — ${SITE.name}` : `${SITE.name} — ${d.hero.tagline}`;
const desc = description ?? d.meta.description;
const nav = [
  { href: '/', label: d.nav.home },
  { href: '/game', label: d.nav.game },
  { href: '/blog', label: d.nav.blog },
  { href: '/about', label: d.nav.about },
];
const isActive = (href: string) => (href === '/' ? page === '/' || page === '' : page.startsWith(href));
const ogImage = await getImage({ src: ogSource, width: 1200, format: 'jpg' });
const year = new Date().getFullYear();
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={new URL(localePath(lang, page), SITE.url)} />
    {langs.map((l) => <link rel="alternate" hreflang={l} href={new URL(localePath(l, page), SITE.url)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(localePath('en', page), SITE.url)} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:image" content={new URL(ogImage.src, SITE.url)} />
    <meta property="og:url" content={new URL(Astro.url.pathname, SITE.url)} />
    <meta name="theme-color" content="#0b1026" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Rubik:wght@500;600;700&family=Nunito:wght@400;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a class="logo" href={localePath(lang, '/')}>
          <img src="/logo.png" alt="" width="34" height="34" />
          <Image class="logo-title" src={gameTitle} alt={SITE.name} height={30} />
        </a>
        <input type="checkbox" id="menu-toggle" class="menu-toggle" aria-label="Menu" />
        <label for="menu-toggle" class="burger" aria-hidden="true"><span></span></label>
        <nav class="nav">
          {nav.map((n) => (
            <a href={localePath(lang, n.href)} class:list={{ active: isActive(n.href) }}>{n.label}</a>
          ))}
          <details class="lang">
            <summary aria-label={d.nav.language}>
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" d="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Zm-9-9h18M12 3c2.5 2.5 3.5 5.5 3.5 9s-1 6.5-3.5 9c-2.5-2.5-3.5-5.5-3.5-9s1-6.5 3.5-9Z"/></svg>
              {lang.toUpperCase()}
            </summary>
            <ul>
              {langs.map((l) => (
                <li><a href={localePath(l, page)} hreflang={l} lang={l} class:list={{ active: l === lang }}>{languages[l]}</a></li>
              ))}
            </ul>
          </details>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-inner">
        <div>
          <a class="logo" href={localePath(lang, '/')}><img src="/logo.png" alt="" width="28" height="28" /><Image class="logo-title" src={gameTitle} alt={SITE.name} height={30} /></a>
          <p class="muted">© {year} {SITE.company}. {d.footer.rights}</p>
        </div>
        <nav class="footer-links">
          <a href={localePath(lang, '/privacy')}>{d.legal.privacy}</a>
          <a href={localePath(lang, '/terms')}>{d.legal.terms}</a>
          <a href={localePath(lang, '/delete-account')}>{d.legal.deleteAccount}</a>
          <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
          <a href={SITE.discord} target="_blank" rel="noopener">Discord</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
