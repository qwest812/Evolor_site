---
import Base from '../../../layouts/Base.astro';
import PostCard from '../../../components/PostCard.astro';
import type { Lang } from '../../../i18n/ui';
import { t, langPaths } from '../../../i18n/utils';
import { getPosts } from '../../../i18n/blog';

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const d = t(lang);
const posts = await getPosts(lang);
---
<Base lang={lang} title={d.blog.title} description={d.blog.intro}>
  <section class="section">
    <div class="container">
      <h1>{d.blog.title}</h1>
      <p class="lead" style="margin-bottom: 40px">{d.blog.intro}</p>
      {posts.length ? <div class="posts">{posts.map((post) => <PostCard post={post} lang={lang} />)}</div> : <p class="muted">{d.blog.empty}</p>}
    </div>
  </section>
</Base>
