---
import Base from '../../layouts/Base.astro';
import StoreButtons from '../../components/StoreButtons.astro';
import { Image } from 'astro:assets';
import { featureStyle } from '../../components/features';
import { featureKeys, type Lang } from '../../i18n/ui';
import { t, langPaths } from '../../i18n/utils';

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const d = t(lang);
---
<Base lang={lang} title={d.game.title}>
  <section class="section center" style="padding-bottom: 24px">
    <div class="container">
      <h1>{d.game.title}</h1>
      <p class="lead">{d.game.intro}</p>
    </div>
  </section>
  <section class="container">
    {featureKeys.map((k) => (
      <div class="feature-row" id={k}>
        <div>
          <h2>{d.features[k].title}</h2>
          <p>{d.features[k].long}</p>
        </div>
        <div class="feature-media" style={`background: ${featureStyle[k].bg}`}>
          {featureStyle[k].image ? <Image src={featureStyle[k].image} alt={d.features[k].title} width={900} /> : <Image class="feature-icon" src={featureStyle[k].icon} alt="" width={320} />}
        </div>
      </div>
    ))}
  </section>
  <section class="section">
    <div class="container center"><StoreButtons lang={lang} discord /></div>
  </section>
</Base>
