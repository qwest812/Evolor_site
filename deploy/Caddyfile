{$SITE_DOMAIN:evolor.tagumplay.com} {
	# Файлы проверки Let's Encrypt: certbot кладёт их в certbot/www/.well-known/acme-challenge/
	handle /.well-known/acme-challenge/* {
		root * /acme
		file_server
	}
	handle {
		root * /srv
		encode zstd gzip
		header /_astro/* Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle_errors 404 {
		root * /srv
		rewrite * /404.html
		file_server
	}
}
